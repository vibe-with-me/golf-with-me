{
  "name": "withme-starter",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "supabase/seed"
  ],
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "turbo run dev",
    "lint": "oxlint --deny-warnings",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "test": "turbo run test",
    "deploy": "turbo run deploy",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:seed": "bun run supabase/seed/index.ts",
    "db:types": "supabase gen types typescript --local > packages/db/src/types/supabase.ts"
  },
  "devDependencies": {
    "oxlint": "^1.69.0",
    "turbo": "^2.5.0"
  },
  "overrides": {
    "expo": "56.0.9"
  }
}
