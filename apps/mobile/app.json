{
  "expo": {
    "name": "Golf With Me",
    "slug": "golfwithme",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "golfwithme",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.golfwithme.app"
    },
    "android": {
      "package": "co.golfwithme.app",
      "adaptiveIcon": {
        "backgroundColor": "#eeebe1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#eeebe1",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#131314"
          }
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Read Golf With Me tags to connect with golfers.",
          "includeNdefEntitlement": false
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "owner": "vibe-with-me",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf56d2f1-eaec-406b-be9c-972519a6be84"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/cf56d2f1-eaec-406b-be9c-972519a6be84"
    }
  }
}
