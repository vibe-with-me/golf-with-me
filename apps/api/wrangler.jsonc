{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "withme-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8787
  },
  "vars": {
    "APP_ENV": "development"
  }
  // Secrets (set via `wrangler secret put` or .dev.vars locally; never in this file):
  // SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY — wired up in the API implementation step.
}
