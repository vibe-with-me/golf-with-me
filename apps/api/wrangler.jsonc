{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "withme-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // 8786 (not wrangler's 8787 default) so this coexists with another local
  // Workers project, matching the 55xxx Supabase port choice.
  "dev": {
    "port": 8786
  },
  "vars": {
    "APP_ENV": "development",
    "CORS_ORIGIN": "http://localhost:3000"
  },
  "ratelimits": [
    {
      "name": "SCAN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
  // Per-deployment config (set as vars for your Worker, or .dev.vars locally —
  // see .dev.vars.example): SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY.
  // The service-role key is never configured here, by design.
}
