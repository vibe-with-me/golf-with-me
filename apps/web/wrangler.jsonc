{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "withme-web",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": {
    "enabled": true
  },
  // Server-side loader calls reach the API worker directly: Cloudflare
  // blocks same-account worker-to-worker fetches over workers.dev URLs.
  "services": [{ "binding": "API", "service": "withme-api" }]
}
