# Copy to .env (gitignored). These are the local-stack shared defaults — not secrets.
VITE_API_URL=http://localhost:8786
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Optional: renders a demo-credentials hint on the landing page (deployed demos).
# VITE_DEMO_CREDENTIALS=ada@demo.golfwithme.local / golfwithme-demo-1
# Optional: your store. Adds the Merch tab and the landing page's "Get tags" link.
# Golf With Me: a placeholder until the store exists (ball markers, bag tags,
# divot tools). Replace it with the real storefront before go-live.
VITE_STORE_URL=https://example.com/golfwithme-shop
# Your terms of use and privacy policy (docs/terms-template.md is the starting
# text). Sign-up and the re-ask screen link to them; set both before go-live.
# VITE_TERMS_URL=https://example.com/terms
# VITE_PRIVACY_URL=https://example.com/privacy
