{
  "name": "@withme/nfc",
  "version": "0.1.0",
  "description": "NFC-to-destination redirect SDK: resolve tag UIDs to destinations, log scans, bring your own storage.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./storage/supabase": {
      "import": {
        "types": "./dist/storage/supabase.d.ts",
        "default": "./dist/storage/supabase.js"
      },
      "require": {
        "types": "./dist/storage/supabase.d.cts",
        "default": "./dist/storage/supabase.cjs"
      }
    },
    "./storage/memory": {
      "import": {
        "types": "./dist/storage/memory.d.ts",
        "default": "./dist/storage/memory.js"
      },
      "require": {
        "types": "./dist/storage/memory.d.cts",
        "default": "./dist/storage/memory.cjs"
      }
    },
    "./adapters/hono": {
      "import": {
        "types": "./dist/adapters/hono.d.ts",
        "default": "./dist/adapters/hono.js"
      },
      "require": {
        "types": "./dist/adapters/hono.d.cts",
        "default": "./dist/adapters/hono.cjs"
      }
    }
  },
  "files": [
    "dist",
    "sql",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "@types/node": "^22.0.0",
    "hono": "^4.7.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
